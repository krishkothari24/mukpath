# Copy to .env if you need to override where the app looks for the backend.
#
#   cp .env.example .env
#
# You usually DON'T need this. With no .env, the app derives the backend
# address from whatever host Metro is serving on — so a phone running Expo Go
# on the same Wi-Fi reaches your Mac automatically. Set this explicitly when
# the backend is somewhere else (a Railway deploy, a tunnel, a different port).
#
# Must be prefixed EXPO_PUBLIC_ to be readable from app code.
# EXPO_PUBLIC_API_URL=http://192.168.1.215:3000
