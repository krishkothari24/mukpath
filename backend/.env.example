# Copy to .env and fill in for local dev. .env is gitignored.
#
#   cp .env.example .env

# Local Postgres. Railway injects its own DATABASE_URL in deployed envs.
DATABASE_URL=postgres://localhost:5432/mukhpath

PORT=3000

# Signs auth JWTs. Any long random string for local dev; a real secret
# in deployed envs (set via `railway variables`, not committed).
JWT_SECRET=dev-only-change-me
