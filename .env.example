# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env
#
# Read by the tools/ and scripts/ helpers only. The Expo app and the
# Fastify backend get their own config; see CLAUDE.md for that boundary.

# --- Phase 0: Telegram content scraper -------------------------------
# From https://my.telegram.org -> API development tools -> create an app.
# Log in with your own phone number. These identify *your* Telegram
# client, not the bot — treat them like a password.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The bot to scrape. Override only if it moves.
MUKHPATH_BOT=nc27mukhpathguidebot

# --- Phase 1: backend (not used yet) ---------------------------------
# DATABASE_URL=postgres://localhost:5432/mukhpath
